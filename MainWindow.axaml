<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PdkOcrClient"
        xmlns:behaviors="clr-namespace:PdkOcrClient.Behaviors"
        xmlns:i="using:Avalonia.Xaml.Interactivity"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="PdkOcrClient.MainWindow"
        x:DataType="local:MainWindowViewModel"
        Title="PdkOcrClient">
    <Grid Margin="20" RowDefinitions="Auto, *, Auto" ColumnDefinitions="*, 300">

        <!-- ─── TOP HEADER ZONE: 컨트롤 및 파일 선택 라인 ─── -->
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" Spacing="15" Margin="0,0,0,20">
            <Button Content="📁 이미지 파일 선택"
                    Padding="15,8"
                    Background="#2b579a"
                    Foreground="White"
                    FontWeight="Bold"
                    Command="{Binding OpenFileDialogCommand}"/>

            <TextBlock Foreground="#666666" FontWeight="SemiBold" VerticalAlignment="Center">
                <Run Text="선택된 파일:"/>
                <Run Text="{Binding SelectedFileName}"/>
            </TextBlock>
        </StackPanel>

        <!-- ─── LEFT MAIN ZONE: 이미지 뷰포트 영역 ─── -->
        <Border Grid.Row="1" Grid.Column="0"
                Background="#F5F5F5"
                CornerRadius="8"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                Margin="0,0,15,0">
            <Grid>
                <Viewbox Stretch="Uniform"
                         Margin="10"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch"
                         Width="{Binding CurrentRoiCanvasWidth, Mode=OneWayToSource}"
                         Height="{Binding CurrentRoiCanvasHeight, Mode=OneWayToSource}"
                         >
                    <Grid>
                        <Image Name="MainVisualViewer"
                               Stretch="None"
                               Source="{Binding MainImage}"/>

                        <Canvas Name="RoiCanvas"
                                Background="Transparent"
                                PointerPressed="RoiCanvas_PointerPressed"
                                PointerMoved="RoiCanvas_PointerMoved"
                                PointerReleased="RoiCanvas_PointerReleased"
                                >
                            <Rectangle Name="RoiRectangle"
                                       Stroke="Red"
                                       Opacity="0.2"
                                       Fill="Red"
                                       StrokeThickness="2"
                                       Canvas.Left="{Binding CurrentRoiX, Mode=TwoWay}"
                                       Canvas.Top="{Binding CurrentRoiY, Mode=TwoWay}"
                                       Width="{Binding CurrentRoiWidth, Mode=TwoWay}"
                                       Height="{Binding CurrentRoiHeight, Mode=TwoWay}"
                                       IsVisible="{Binding CurrentRoiIsVisible}"/>
                        </Canvas>
                    </Grid>
                </Viewbox>

                <!-- 이미지가 없을 때 띄워줄 청정 가이드 레이블 -->
                <TextBlock Text="버튼을 눌러 이미지를 로드해 주세요"
                           IsVisible="{Binding MainImage, Converter={x:Static ObjectConverters.IsNull}}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#999999"/>
            </Grid>
        </Border>

        <!-- ─── RIGHT SIDEBAR ZONE: 선택 영역 목록 (ROI List) ─── -->
        <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto, *">
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                <TextBlock Grid.Column="0"
                           Text="🎯 탐색 선택 영역 목록"
                           FontWeight="Bold"
                           FontSize="14"
                           Foreground="#333333"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="➕ ROI 추가"
                        Padding="10,6"
                        Background="#2b579a"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Command="{Binding AddRoiCommand}"/>
            </Grid>

            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    CornerRadius="6">
                <!-- 선택 영역과 OCR 텍스트를 함께 보여줄 리스트박스 -->
                <ListBox Name="RoiAreaListBox"
                         Background="Transparent">
                    <ListBoxItem>
                        <StackPanel Spacing="4">
                            <TextBlock Text="ROI1"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="OCR 결과:쿠라몬"
                                       Foreground="#2b579a"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Spacing="4">
                            <TextBlock Text="ROI2"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="OCR 결과:유년기I"
                                       Foreground="#2b579a"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Spacing="4">
                            <TextBlock Text="ROI3"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="OCR 결과:NO DATA"
                                       Foreground="#2b579a"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Border>
        </Grid>

        <!-- ─── BOTTOM STATUS ZONE: 파이썬 서버 비동기 통신 격발 라인 ─── -->
        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                    Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
            <Button Content="🖼️ 템플릿 저장"
                    Padding="16,10"
                    Background="#2b579a"
                    Foreground="White"
                    FontWeight="Bold"
                    />
            <Button Content="📝 OCR 결과 저장"
                    Padding="16,10"
                    Background="#107c41"
                    Foreground="White"
                    FontWeight="Bold"
                    />
            <Button Content="⚡ OCR 분석 시작"
                    Padding="20,10"
                    Background="#107c41"
                    Foreground="White"
                    FontWeight="Bold"
                    />
        </StackPanel>
    </Grid></Window>
