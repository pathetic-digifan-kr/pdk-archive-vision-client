<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PdkOcrClient"
        xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
        mc:Ignorable="d"
        d:DesignWidth="1100"
        d:DesignHeight="720"
        x:Class="PdkOcrClient.MainWindow"
        x:DataType="local:MainWindowViewModel"
        Title="PDK Archive Vision"
        Width="1100"
        Height="720"
        MinWidth="900"
        MinHeight="620"
        Background="#F3F5F8"
        SelectedRectangle="{Binding SelectedInspectionRegion, Mode=TwoWay}"
        >
    <Window.KeyBindings>
        <KeyBinding Gesture="Space" Command="{Binding AddRoiCommand}" />
    </Window.KeyBindings>

    <Window.Styles>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,9" />
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,9" />
        </Style>
        <Style Selector="Button.success">
            <Setter Property="Background" Value="#0F766E" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,10" />
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#64748B" />
        </Style>
        <Style Selector="Button.icon">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto, Auto, *, Auto">
        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#D8DEE8"
                BorderThickness="0,0,0,1">
            <Menu Background="Transparent" Margin="18,0">
                <MenuItem Header="파일">
                    <MenuItem Header="이미지 열기"
                              Command="{Binding OpenFileDialogCommand}" />
                </MenuItem>
                <MenuItem Header="템플릿">
                    <MenuItem Header="템플릿 불러오기"
                              Command="{Binding LoadRoiTemplateCommand}" />
                    <MenuItem Header="현재 ROI 템플릿 저장"
                              Command="{Binding SaveRoiTemplateCommand}" />
                </MenuItem>
                <MenuItem Header="OCR">
                    <MenuItem Header="OCR 분석 시작"
                              Command="{Binding DoOcrCommand}" />
                </MenuItem>
            </Menu>
        </Border>

        <Grid Grid.Row="1"
              Margin="24,18,24,14"
              ColumnDefinitions="*, Auto"
              ColumnSpacing="16">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="PDK Archive Vision"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#111827" />
                <TextBlock Text="이미지를 불러오고 ROI를 지정한 뒤 OCR 분석을 실행하세요."
                           Classes="muted" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                <Button Classes="secondary"
                        Content="이미지 열기"
                        Command="{Binding OpenFileDialogCommand}" />
                <Button Classes="primary"
                        Content="템플릿 불러오기"
                        Command="{Binding LoadRoiTemplateCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2"
              Margin="24,0,24,0"
              ColumnDefinitions="*, 320"
              ColumnSpacing="16">
            <Border Grid.Column="0"
                    Background="#FFFFFF"
                    BorderBrush="#D8DEE8"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid RowDefinitions="Auto, *">
                    <Grid Grid.Row="0"
                          ColumnDefinitions="*, Auto"
                          Margin="16,14,16,10">
                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock Text="이미지 작업 영역"
                                       Classes="section-title" />
                            <TextBlock Classes="muted"
                                       TextWrapping="Wrap">
                                <Run Text="현재 파일: " />
                                <Run Text="{Binding SelectedFileName}" />
                            </TextBlock>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Classes="secondary"
                                Content="ROI 추가"
                                VerticalAlignment="Center"
                                Command="{Binding AddRoiCommand}" />
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="16,0,16,16"
                            Background="#EEF2F7"
                            BorderBrush="#D8DEE8"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>
                            <Viewbox Stretch="Uniform"
                                     Margin="14"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch"
                                     Width="{Binding CurrentRoiCanvasWidth, Mode=OneWayToSource}"
                                     Height="{Binding CurrentRoiCanvasHeight, Mode=OneWayToSource}">
                                <Grid>
                                    <Image Name="MainVisualViewer"
                                           Stretch="None"
                                           Source="{Binding MainImage}" />


                                    <Canvas Name="RoiCanvas"
                                            Background="Transparent">
                                        <Rectangle Name="RoiRectangle"
                                                   Stroke="#DC2626"
                                                   Opacity="0.24"
                                                   Fill="#DC2626"
                                                   StrokeThickness="2"
                                                   Canvas.Left="{Binding CurrentRoiX, Mode=TwoWay}"
                                                   Canvas.Top="{Binding CurrentRoiY, Mode=TwoWay}"
                                                   Width="{Binding CurrentRoiWidth, Mode=TwoWay}"
                                                   Height="{Binding CurrentRoiHeight, Mode=TwoWay}"
                                                   IsVisible="{Binding CurrentRoiIsVisible}" />
                                    </Canvas>

                                    <ItemsControl ItemsSource="{Binding InspectionRegions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.Styles>
                                            <Style Selector="ItemsControl > ContentPresenter" x:DataType="local:InspectionRegion">
                                                <Setter Property="Canvas.Left" Value="{Binding X, Mode=TwoWay}" />
                                                <Setter Property="Canvas.Top" Value="{Binding Y, Mode=TwoWay}" />
                                            </Style>
                                        </ItemsControl.Styles>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <local:SelectableRectangle PointerPressed="SelectableRectangle_PointerPressed"
                                                                           IsSelected="{Binding IsSelected, Mode=TwoWay}">
                                                    <i:Interaction.Behaviors>
                                                        <local:DragMoveBehavior />
                                                    </i:Interaction.Behaviors>
                                                </local:SelectableRectangle>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </Grid>
                            </Viewbox>

                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="10"
                                        IsVisible="{Binding MainImage, Converter={x:Static ObjectConverters.IsNull}}">
                                <TextBlock Text="이미지가 아직 선택되지 않았습니다."
                                           Foreground="#475569"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="상단의 이미지 열기 또는 템플릿 불러오기를 사용하세요."
                                           Classes="muted"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="#FFFFFF"
                    BorderBrush="#D8DEE8"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid RowDefinitions="Auto, *">
                    <Border Grid.Row="0"
                            Padding="16,14"
                            BorderBrush="#E2E8F0"
                            BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock Text="ROI 목록"
                                           Classes="section-title" />
                                <TextBlock Text="선택 영역과 OCR 결과"
                                           Classes="muted" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding InspectionRegions.Count}"
                                       Foreground="#2563EB"
                                       FontWeight="Bold"
                                       FontSize="20"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1"
                             Name="RoiAreaListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Margin="8"
                             ItemsSource="{Binding InspectionRegions}"
                             SelectionMode="Single"
                             SelectedItem="{Binding SelectedInspectionRegion, Mode=TwoWay}"
                             >
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8FAFC"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10"
                                        Margin="0,0,0,8">
                                    <StackPanel Spacing="5">
                                        <Grid ColumnDefinitions="*, Auto"
                                              ColumnSpacing="6">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding RegionName}"
                                                       Foreground="#111827"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding IsEditingName, Converter={x:Static BoolConverters.Not}}" />
                                            <Button Grid.Column="1"
                                                    Classes="icon"
                                                    Content="✎"
                                                    ToolTip.Tip="ROI 이름 수정"
                                                    Command="{Binding StartEditingNameCommand}"
                                                    IsVisible="{Binding IsEditingName, Converter={x:Static BoolConverters.Not}}" />
                                            <TextBox Grid.Column="0"
                                                     Name="RoiNameEditor"
                                                     Text="{Binding RegionName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Foreground="#111827"
                                                     FontWeight="SemiBold"
                                                     Watermark="ROI 이름"
                                                     BorderBrush="#2563EB"
                                                     Background="#FFFFFF"
                                                     Padding="6,4"
                                                     IsVisible="{Binding IsEditingName}">
                                                <i:Interaction.Behaviors>
                                                    <local:CommitTextBoxEditBehavior IsEditing="{Binding IsEditingName}"
                                                                                     CompleteCommand="{Binding CompleteEditingNameCommand}" />
                                                </i:Interaction.Behaviors>
                                            </TextBox>
                                            <Button Grid.Column="1"
                                                    Classes="icon"
                                                    Content="✓"
                                                    ToolTip.Tip="ROI 이름 수정 완료"
                                                    Command="{Binding CompleteEditingNameCommand}"
                                                    IsVisible="{Binding IsEditingName}" />
                                        </Grid>
                                        <TextBlock Foreground="#2563EB"
                                                   TextWrapping="Wrap">
                                            <Run Text="OCR 결과: " />
                                            <Run Text="{Binding OcrResult}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Margin="24,16,24,24"
                Background="#FFFFFF"
                BorderBrush="#D8DEE8"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">
                    <Button Classes="secondary"
                            Content="템플릿 저장"
                            Command="{Binding SaveRoiTemplateCommand}" />
                    <Button Classes="secondary"
                            Content="OCR 결과 저장" />
                </StackPanel>

                <Button Grid.Column="1"
                        Classes="success"
                        Content="OCR 분석 시작"
                        Command="{Binding DoOcrCommand}" />
            </Grid>
        </Border>
    </Grid>
</Window>
