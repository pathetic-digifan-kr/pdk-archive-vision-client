<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:PdkOcrClient"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="PdkOcrClient.SelectableRectangle"
             x:DataType="local:InspectionRegion"
             x:Name="Root"
             Cursor="Hand"
             Background="Transparent"
             IsHitTestVisible="True">
  <Border x:Name="SelectionBorder"
          BorderBrush="#2563EB"
          BorderThickness="1"
          CornerRadius="4"
          Padding="2"
          ClipToBounds="False">
    <Grid Width="{Binding Width}"
          Height="{Binding Height}">
      <Rectangle x:Name="RegionFill"
                 Stroke="#2563EB"
                 Fill="#2563EB"
                 Opacity="0.18"
                 StrokeThickness="2" />
      <Rectangle x:Name="SelectionHighlight"
                 IsVisible="False"
                 Stroke="#38BDF8"
                 Fill="#38BDF8"
                 Opacity="0.12"
                 StrokeThickness="3" />
      <Grid x:Name="SelectionHandles"
            IsVisible="False"
            IsHitTestVisible="False"
            Width="{Binding Width}"
            Height="{Binding Height}"
            ClipToBounds="False">
        <Border Width="10"
                Height="10"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="-5,-5,0,0"
                Background="#F8FAFC"
                BorderBrush="#38BDF8"
                BorderThickness="2"
                CornerRadius="2" />
        <Border Width="10"
                Height="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,-5,0,0"
                Background="#F8FAFC"
                BorderBrush="#38BDF8"
                BorderThickness="2"
                CornerRadius="2" />
        <Border Width="10"
                Height="10"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,-5,-5,0"
                Background="#F8FAFC"
                BorderBrush="#38BDF8"
                BorderThickness="2"
                CornerRadius="2" />
        <Border Width="10"
                Height="10"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Margin="-5,0,0,0"
                Background="#F8FAFC"
                BorderBrush="#38BDF8"
                BorderThickness="2"
                CornerRadius="2" />
        <Border Width="10"
                Height="10"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,-5,0"
                Background="#F8FAFC"
                BorderBrush="#38BDF8"
                BorderThickness="2"
                CornerRadius="2" />
        <Border Width="10"
                Height="10"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="-5,0,0,-5"
                Background="#F8FAFC"
                BorderBrush="#38BDF8"
                BorderThickness="2"
                CornerRadius="2" />
        <Border Width="10"
                Height="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,-5"
                Background="#F8FAFC"
                BorderBrush="#38BDF8"
                BorderThickness="2"
                CornerRadius="2" />
        <Border Width="10"
                Height="10"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,-5,-5"
                Background="#F8FAFC"
                BorderBrush="#38BDF8"
                BorderThickness="2"
                CornerRadius="2" />
      </Grid>
      <Border Background="#2563EB"
              CornerRadius="3"
              Padding="5,2"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              MaxWidth="{Binding Width}">
        <TextBlock Text="{Binding RegionName}"
                   Foreground="White"
                   FontSize="16"
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis" />
      </Border>
    </Grid>
  </Border>
</UserControl>
