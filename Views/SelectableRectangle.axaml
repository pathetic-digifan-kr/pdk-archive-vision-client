<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:PdkOcrClient"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="PdkOcrClient.SelectableRectangle"
             x:DataType="local:InspectionRegion"
             x:Name="Root"
             Cursor="Hand"
             Background="Transparent"
             Width="{Binding Width, Mode=TwoWay}"
             Height="{Binding Height, Mode=TwoWay}"
             IsHitTestVisible="True">
        <UserControl.Styles>
                <Style Selector="local|SelectableRectangle">
                        <Style Selector="^ Grid#SelectionHandles Thumb">
                                <Setter Property="Template">
                                        <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="5" />
                                        </ControlTemplate>
                                </Setter>
                        </Style>

                        <Style Selector="^ Border#SelectionBorder">
                                <Setter Property="BorderBrush" Value="#2563EB" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="Padding" Value="2" />
                        </Style>

                        <Style Selector="^:selected Border#SelectionBorder">
                                <Setter Property="BorderBrush" Value="#38BDF8" />
                                <Setter Property="BorderThickness" Value="2" />
                                <Setter Property="Padding" Value="3" />
                        </Style>

                        <Style Selector="^ Rectangle#RegionFill">
                                <Setter Property="Stroke" Value="#2563EB" />
                                <Setter Property="Fill" Value="#2563EB" />
                                <Setter Property="StrokeThickness" Value="2" />
                                <Setter Property="Opacity" Value="0.24" />
                        </Style>

                        <Style Selector="^:selected Rectangle#RegionFill">
                                <Setter Property="Stroke" Value="#38BDF8" />
                                <Setter Property="Fill" Value="#38BDF8" />
                                <Setter Property="StrokeThickness" Value="3" />
                                <Setter Property="Opacity" Value="0.18" />
                        </Style>

                        <Style Selector="^ Rectangle#SelectionHighlight">
                                <Setter Property="IsVisible" Value="False" />
                        </Style>
                        <Style Selector="^:selected Rectangle#SelectionHighlight">
                                <Setter Property="IsVisible" Value="True" />
                        </Style>

                        <Style Selector="^ Grid#SelectionHandles">
                                <Setter Property="IsVisible" Value="False" />
                        </Style>
                        <Style Selector="^:selected Grid#SelectionHandles">
                                <Setter Property="IsVisible" Value="True" />
                        </Style>
                </Style>
        </UserControl.Styles>
        <Border x:Name="SelectionBorder"
                CornerRadius="4"
                ClipToBounds="False">
                <Grid >
                        <Rectangle x:Name="RegionFill"/>
                        <Rectangle x:Name="SelectionHighlight"
                                   Stroke="#38BDF8"
                                   Fill="#38BDF8"
                                   Opacity="0.12"
                                   StrokeThickness="3" />
                        <Grid x:Name="SelectionHandles"
                              IsHitTestVisible="True"
                              ClipToBounds="False">
                                <Border Width="10"
                                        Height="10"
                                        Tag="TopLeft"
                                        Cursor="TopLeftCorner"
                                        PointerMoved="Handle_PointerMoved"
                                        PointerPressed="Handle_PointerPressed"
                                        PointerReleased="Handle_PointerReleased"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="-5,-5,0,0"
                                        Background="#F8FAFC"
                                        BorderBrush="#38BDF8"
                                        BorderThickness="2"
                                        CornerRadius="5" />
                                <Border Width="10"
                                        Height="10"
                                        Tag="TopCenter"
                                        Cursor="SizeNorthSouth"
                                        PointerMoved="Handle_PointerMoved"
                                        PointerPressed="Handle_PointerPressed"
                                        PointerReleased="Handle_PointerReleased"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        Margin="0,-5,0,0"
                                        Background="#F8FAFC"
                                        BorderBrush="#38BDF8"
                                        BorderThickness="2"
                                        CornerRadius="5" />
                                <Border Width="10"
                                        Height="10"
                                        Tag="TopRight"
                                        Cursor="TopRightCorner"
                                        PointerMoved="Handle_PointerMoved"
                                        PointerPressed="Handle_PointerPressed"
                                        PointerReleased="Handle_PointerReleased"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,-5,-5,0"
                                        Background="#F8FAFC"
                                        BorderBrush="#38BDF8"
                                        BorderThickness="2"
                                        CornerRadius="5" />
                                <Border Width="10"
                                        Height="10"
                                        Tag="CenterLeft"
                                        Cursor="SizeWestEast"
                                        PointerMoved="Handle_PointerMoved"
                                        PointerPressed="Handle_PointerPressed"
                                        PointerReleased="Handle_PointerReleased"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="-5,0,0,0"
                                        Background="#F8FAFC"
                                        BorderBrush="#38BDF8"
                                        BorderThickness="2"
                                        CornerRadius="5" />
                                <Border Width="10"
                                        Height="10"
                                        Tag="CenterRight"
                                        Cursor="SizeWestEast"
                                        PointerMoved="Handle_PointerMoved"
                                        PointerPressed="Handle_PointerPressed"
                                        PointerReleased="Handle_PointerReleased"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,-5,0"
                                        Background="#F8FAFC"
                                        BorderBrush="#38BDF8"
                                        BorderThickness="2"
                                        CornerRadius="5" />
                                <Border Width="10"
                                        Height="10"
                                        Tag="BottomLeft"
                                        Cursor="BottomLeftCorner"
                                        PointerMoved="Handle_PointerMoved"
                                        PointerPressed="Handle_PointerPressed"
                                        PointerReleased="Handle_PointerReleased"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Margin="-5,0,0,-5"
                                        Background="#F8FAFC"
                                        BorderBrush="#38BDF8"
                                        BorderThickness="2"
                                        CornerRadius="5" />
                                <Border Width="10"
                                        Height="10"
                                        Tag="BottomCenter"
                                        Cursor="SizeNorthSouth"
                                        PointerMoved="Handle_PointerMoved"
                                        PointerPressed="Handle_PointerPressed"
                                        PointerReleased="Handle_PointerReleased"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,0,-5"
                                        Background="#F8FAFC"
                                        BorderBrush="#38BDF8"
                                        BorderThickness="2"
                                        CornerRadius="5" />
                                <Border Width="10"
                                        Height="10"
                                        Tag="BottomRight"
                                        Cursor="BottomRightCorner"
                                        PointerMoved="Handle_PointerMoved"
                                        PointerPressed="Handle_PointerPressed"
                                        PointerReleased="Handle_PointerReleased"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,-5,-5"
                                        Background="#F8FAFC"
                                        BorderBrush="#38BDF8"
                                        BorderThickness="2"
                                        CornerRadius="5" />
                        </Grid>
                        <Border Background="#2563EB"
                                CornerRadius="3"
                                Padding="5,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                MaxWidth="{Binding Width}">
                                <TextBlock Text="{Binding RegionName}"
                                           Foreground="White"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                        </Border>
                </Grid>
        </Border>
</UserControl>
