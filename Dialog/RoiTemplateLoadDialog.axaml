<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PdkOcrClient.ViewModels"
        mc:Ignorable="d"
        d:DesignWidth="720"
        d:DesignHeight="480"
        x:Class="PdkOcrClient.Dialog.RoiTemplateLoadDialog"
        x:DataType="vm:RoiTemplateLoadDialogViewModel"
        Title="템플릿 불러오기"
        Width="720"
        Height="480"
        MinWidth="640"
        MinHeight="420"
        Background="#F7F7F7">
    <Grid RowDefinitions="*, Auto" Margin="16" RowSpacing="12">
        <Grid Grid.Row="0" ColumnDefinitions="280, *" ColumnSpacing="12">
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    CornerRadius="6">
                <ListBox ItemsSource="{Binding Templates}"
                         SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:RoiTemplateListItem">
                            <StackPanel Spacing="4" Margin="2">
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding RegionCountText}"
                                               Foreground="#2b579a"
                                               FontSize="12" />
                                    <TextBlock Text="{Binding CreatedAtText}"
                                               Foreground="#666666"
                                               FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="1"
                    Background="White"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14">
                <Grid RowDefinitions="Auto, *, Auto" RowSpacing="12">
                    <StackPanel Grid.Row="0" Spacing="4">
                        <TextBlock Text="{Binding SelectedTemplate.Name, FallbackValue='템플릿을 선택하세요'}"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedTemplate.ImageStatusText}"
                                   Foreground="#666666"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Background="#F5F5F5"
                            BorderBrush="#DDDDDD"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <Image Source="{Binding SelectedTemplate.ImagePreview}"
                                   Stretch="Uniform"
                                   Margin="10" />
                            <TextBlock Text="저장된 이미지가 없습니다."
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#999999"
                                       IsVisible="{Binding SelectedTemplate.ImagePreview, Converter={x:Static ObjectConverters.IsNull}}" />
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="2"
                               Text="{Binding SelectedTemplate.RegionCountText}"
                               Foreground="#333333"
                               FontWeight="SemiBold" />
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10">
            <Button Content="불러오기"
                    IsDefault="True"
                    Padding="16,8"
                    Background="#2b579a"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Command="{Binding LoadCommand}" />
            <Button Content="취소"
                    IsCancel="True"
                    Padding="16,8"
                    Background="#F0F0F0"
                    Foreground="#333333"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    FontWeight="SemiBold"
                    Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</Window>
